# Valores de exemplo apenas para desenvolvimento local.
NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=3000
WEB_PORT=5173
LOG_LEVEL=info

# Origem pública da API define Secure do cookie (HTTPS => true).
API_PUBLIC_URL=http://localhost:3000
WEB_ORIGIN=http://localhost:5173
SESSION_TTL_SECONDS=86400

# Porta publicada no host; dentro do Compose o banco usa postgres:5432.
POSTGRES_PORT=5434
POSTGRES_DB=support_agent
POSTGRES_USER=support
POSTGRES_PASSWORD=change-me-local

# Uso local fora do Docker. Manter consistente com POSTGRES_*.
# Codificar caracteres reservados de usuário/senha na URL (percent-encoding).
DATABASE_URL=postgresql://support:change-me-local@localhost:5434/support_agent?schema=public

# Banco separado; criar explicitamente antes de npm run test:integration.
TEST_DATABASE_URL=postgresql://support:change-me-local@localhost:5434/support_agent_test?schema=public

# URL pública da API: incorporada ao frontend durante o build.
# Nunca usar o prefixo VITE_ para segredos.
VITE_API_URL=http://localhost:3000

# Somente backend. Sem chave, o agente oferece encaminhamento simulado.
AI_PROVIDER=gemini
# Insira a chave somente no .env local, nunca neste exemplo ou no frontend.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_MS=10000
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TIMEOUT_MS=10000
FAKE_STORE_TIMEOUT_MS=5000
CONFIRMATION_TTL_SECONDS=300
