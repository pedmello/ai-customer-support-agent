{
  "name": "@support/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "npm run db:generate && tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "npm run db:generate && tsc --noEmit",
    "test": "npm run db:generate && vitest run",
    "test:watch": "npm run db:generate && vitest",
    "test:integration": "npm run db:generate && tsx scripts/migrate-test.ts && vitest run --config vitest.integration.config.ts",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status"
  },
  "dependencies": {
    "@google/genai": "2.30.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "dotenv": "^17.2.3",
    "express": "^5.3.0",
    "helmet": "^8.1.0",
    "openai": "7.39.0",
    "pino": "^10.0.0",
    "pino-http": "^11.0.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^6.0.3",
    "@types/swagger-ui-express": "^4.1.8",
    "prisma": "7.10.1",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "vitest": "^5.0.5"
  }
}
